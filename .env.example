# Copy this file to .env.local and fill in your project values.
# Never commit .env.local or any real credentials.

# Supabase project base URL only. Do not append /rest/v1/ or /auth/v1/;
# the app adds those API paths itself and strips accidental suffixes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe publishable key. For legacy projects, use the anon key instead
# (exactly one of the two key variables).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me

# Canonical origin for absolute metadata URLs and the fallback for
# email-confirmation redirects when the incoming request origin is unavailable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never place a service-role or secret key in any NEXT_PUBLIC_* variable.
